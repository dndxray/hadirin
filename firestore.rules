rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roleName) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (roleName in profileDoc().data.get('roles', []) || profileDoc().data.role == roleName);
    }

    function isAsisten() {
      return hasRole('asisten');
    }

    function isPraktikan() {
      return hasRole('praktikan');
    }

    function validNim(data) {
      return !('nim' in data) || (data.nim is string && data.nim.matches('^[A-Z0-9][A-Z0-9._/-]{2,29}$'));
    }

    // Data lab (koleksi milik SRS-22)
    function validLab(data) {
      return data.keys().hasOnly(['name', 'latitude', 'longitude', 'radiusMeters'])
        && data.keys().hasAll(['name', 'latitude', 'longitude', 'radiusMeters'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.latitude is number
        && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180 && data.longitude <= 180
        && data.radiusMeters is number
        && data.radiusMeters >= 1 && data.radiusMeters <= 1000;
    }

    function validPushTokens(data) {
      return data.get('expoPushTokens', []) is list && data.get('expoPushTokens', []).size() <= 20;
    }

    // Profil akun
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAsisten());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['asisten', 'praktikan']
                    && validNim(request.resource.data)
                    && validPushTokens(request.resource.data)
                    && request.resource.data.get('roles', [request.resource.data.role]).hasOnly(['praktikan', 'asisten'])
                    && (!('asisten' in request.resource.data.get('roles', []))
                        || request.resource.data.get('approvalStatus', '') == 'pending');
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && validNim(request.resource.data)
                    && validPushTokens(request.resource.data)
                    && (!('nim' in resource.data) || resource.data.nim == '' || request.resource.data.nim == resource.data.nim)
                    && request.resource.data.get('roles', [resource.data.role]).hasOnly(['praktikan', 'asisten'])
                    && (!('asisten' in request.resource.data.get('roles', []))
                        || resource.data.get('approvalStatus', '') == 'approved'
                        || request.resource.data.get('approvalStatus', '') == 'pending');
      allow delete: if false;
    }

    // Laboratorium
    match /labs/{labId} {
      allow read: if signedIn();
      allow create, update: if isAsisten() && validLab(request.resource.data);
      allow delete: if isAsisten();
    }

    // Kelas dan peserta
    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAsisten();
    }

    // Mata kuliah. Dua nama koleksi diizinkan supaya cocok dengan yang dipakai
    // aplikasi; hapus salah satunya kalau sudah dipastikan tidak terpakai.
    match /courses/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAsisten();
    }

    match /matkul/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAsisten();
    }

    function sessionData(id) {
      return get(/databases/$(database)/documents/sessions/$(id)).data;
    }

    function participant(id) {
      return isPraktikan() && request.auth.uid in sessionData(id).participantIds;
    }

    function hasWindow(s) {
      return s.keys().hasAll(['opensAt', 'closesAt']);
    }

    // Sesi boleh dipakai presensi:
    // - tidak ditutup manual oleh asisten, dan
    // - request.time ada di antara jam mulai dan jam selesai.
    // Sesi lama yang belum punya opensAt/closesAt memakai field status.
    function sessionLive(s) {
      return s.get('status', '') != 'closed'
        && (hasWindow(s)
          ? (request.time >= s.opensAt && request.time <= s.closesAt)
          : s.get('status', '') == 'open');
    }

    // Izin boleh diajukan selama sesi belum selesai dan belum ditutup.
    function sessionAcceptsPermission(s) {
      return s.get('status', '') in ['open', 'upcoming']
        && (!hasWindow(s) || request.time <= s.closesAt);
    }

    function validSummary(data) {
      let s = sessionData(data.sessionId);
      return data.session == {
        'courseName': s.courseName, 'className': s.className,
        'dateLabel': s.dateLabel, 'timeRange': s.timeRange,
        'room': s.room, 'assistantName': s.assistantName
      };
    }

    function validAttendanceLocation(data) {
      let s = sessionData(data.sessionId);
      let lab = get(/databases/$(database)/documents/labs/$(s.labId)).data;
      let radius = s.get('attendanceRadiusMeters', lab.radiusMeters);
      let location = data.location;
      return validLab(lab) && data.labId == s.labId
        && radius is number && radius >= 1 && radius <= 1000
        && location.keys().hasOnly(['point', 'accuracy', 'observedAt'])
        && location.point is latlng
        && location.accuracy is number && location.accuracy >= 0
        && location.accuracy <= 50 && location.accuracy <= radius
        && location.observedAt is timestamp
        && location.observedAt >= request.time - duration.value(30, 's')
        && location.observedAt <= request.time + duration.value(5, 's')
        && location.point.distance(latlng.value(lab.latitude, lab.longitude)) <= radius
        && (data.method == 'location' && !('qrToken' in data)
          || data.method == 'qr' && s.qrToken is string
            && s.qrToken.matches('^[A-Za-z0-9_-]{16,128}$') && data.qrToken == s.qrToken);
    }

    // Sesi Praktikum
    match /sessions/{id} {
      allow read: if isAsisten() || (isPraktikan() && request.auth.uid in resource.data.participantIds);
      allow create, update, delete: if isAsisten();
    }

    // Presensi Kehadiran
    match /attendance/{id} {
      allow get: if isAsisten() || (isPraktikan() &&
        (!exists(/databases/$(database)/documents/attendance/$(id)) || resource.data.practitionerId == request.auth.uid));
      allow list: if isAsisten() || (isPraktikan() && resource.data.practitionerId == request.auth.uid);
      allow create: if isPraktikan()
        && request.resource.data.keys().hasOnly(['sessionId', 'practitionerId', 'checkedInAt', 'session', 'labId', 'method', 'location', 'qrToken'])
        && request.resource.data.keys().hasAll(['sessionId', 'practitionerId', 'checkedInAt', 'session', 'labId', 'method', 'location'])
        && request.resource.data.practitionerId == request.auth.uid
        && id == request.resource.data.sessionId + '_' + request.auth.uid
        && participant(request.resource.data.sessionId)
        && sessionLive(sessionData(request.resource.data.sessionId))
        && request.resource.data.checkedInAt == request.time
        && validSummary(request.resource.data)
        && validAttendanceLocation(request.resource.data)
        && !existsAfter(/databases/$(database)/documents/permissionRequests/$(id));
      allow update, delete: if false;
    }

    // Pengajuan Izin
    match /permissionRequests/{id} {
      // Asisten bisa baca semua, praktikan hanya miliknya sendiri
      allow get: if isAsisten() || (isPraktikan() &&
        (!exists(/databases/$(database)/documents/permissionRequests/$(id)) || resource.data.practitionerId == request.auth.uid));
      allow list: if isAsisten() || (isPraktikan() && resource.data.practitionerId == request.auth.uid);

      // Praktikan mengajukan izin
      allow create: if isPraktikan()
        && request.resource.data.keys().hasOnly(['sessionId', 'practitionerId', 'reason', 'status', 'createdAt', 'session', 'ai'])
        && request.resource.data.practitionerId == request.auth.uid
        && id == request.resource.data.sessionId + '_' + request.auth.uid
        && participant(request.resource.data.sessionId)
        && sessionAcceptsPermission(sessionData(request.resource.data.sessionId))
        && request.resource.data.reason is string
        && request.resource.data.reason.trim().size() >= 10 && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.ai == {'status': 'pending'}
        && validSummary(request.resource.data)
        && !existsAfter(/databases/$(database)/documents/attendance/$(id));

      // Asisten memutuskan (setuju atau tolak) atau memperbarui hasil AI
      allow update: if isAsisten() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ai'])
          && request.resource.data.ai.keys().hasOnly(['status', 'category', 'error'])
          && request.resource.data.ai.status in ['success', 'failed']
          && (request.resource.data.ai.status != 'success' || request.resource.data.ai.category is string))
        || (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionNote', 'decidedBy', 'decidedAt'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.decidedAt == request.time)
      );

      allow delete: if false;
    }

    // Notifikasi in-app
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.toUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAsisten()
        && request.resource.data.keys().hasOnly(['toUserId', 'type', 'title', 'body', 'sessionId', 'createdAt', 'read'])
        && request.resource.data.toUserId is string
        && request.resource.data.read == false;
      allow delete: if false;
    }
  }
}