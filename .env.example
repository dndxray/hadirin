# Firebase Console > Project settings > Your apps > Web app configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Optional local development only. Do not enable against a real project.
EXPO_PUBLIC_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Optional native Android push setup: local path or EAS file environment variable.
# Do not put FCM service-account/private keys in EXPO_PUBLIC_* variables.
GOOGLE_SERVICES_JSON=
